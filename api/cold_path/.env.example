# Service B: cold path (second Render Web Service). Set in the Render
# dashboard → Environment. Never commit real values. If any required value is
# blank, the service starts with the consumer disabled.

# Aiven Kafka: the same service and SASL user as Service A.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_CA_CERT=
KAFKA_FRAUD_ALERTS_TOPIC=fraud_alerts
KAFKA_COLD_PATH_GROUP=mulewatch-cold-path
KAFKA_COLD_PATH_DLQ_TOPIC=fraud_alerts_dlq

# MongoDB Atlas (Database → Connect → Drivers). Server only.
MONGODB_URI=
MONGODB_DATABASE=mulewatch

# Supabase ledger, read-only use. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects POST /wake; must equal Service A's MULEWATCH_API_KEY.
MULEWATCH_API_KEY=
