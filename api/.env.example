# FastAPI inference service (Render). Set these in the Render dashboard →
# Environment. Never commit real values. Leave the KAFKA_* values blank to run
# without the consumer; /predict and /health work either way.

# Aiven Kafka (service overview → Connection information, SASL tab).
# Comma-separated host:port list for the SASL listener.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# PLAIN (default); SCRAM-SHA-256 / SCRAM-SHA-512 also work.
KAFKA_SASL_MECHANISM=PLAIN
# Aiven project CA certificate (PEM). Newlines may be written as \n.
KAFKA_CA_CERT=
KAFKA_TOPIC=raw-transactions
KAFKA_DLQ_TOPIC=raw-transactions-dlq
# Model-flagged, persisted transactions are announced here (create manually).
KAFKA_FRAUD_ALERTS_TOPIC=fraud_alerts
KAFKA_CONSUMER_GROUP=mulewatch-predict-consumer

# Deployed frontend whose /api/predict scores and saves each record.
MULEWATCH_FRONTEND_URL=https://mule-watch.vercel.app
# Must equal MULEWATCH_API_KEY in the frontend's Vercel environment.
MULEWATCH_API_KEY=

# Optional: Service B's wake URL (https://<cold-path>.onrender.com/wake). After
# each fraud_alerts publish, Service A pings it, best effort.
COLD_PATH_WAKE_URL=
