
# ==========================================
# SECRETS AND ENVIRONMENT VARIABLES
# ==========================================
**/.env
**/.env.*
**/.envrc

# Allow safe example files to be committed.
!**/.env.example
!**/.env.*.example

# ==========================================
# CREDENTIALS AND PRIVATE KEYS
# ==========================================
**/kaggle.json
**/credentials.json
**/*service-account*.json
**/*-credentials.json

**/secrets/
**/secret/
**/credentials/

**/.netrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/*.token

# ==========================================
# NODE.JS AND NEXT.JS
# ==========================================
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/coverage/

**/.vercel/
**/.turbo/

.pnp
.pnp.*

# Yarn cache and generated files.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Package manager logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# PYTHON AND FASTAPI
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class

**/.venv/
**/venv/
**/ENV/
**/env/

**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.pyre/
**/.tox/
**/.nox/

.coverage
.coverage.*
htmlcov/
coverage.xml

# ==========================================
# DATASETS AND PRIVATE DATA
# ==========================================
data/
datasets/
private_data/
uploads/

*.csv
*.tsv
*.parquet
*.feather

# Local databases and backups.
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# ==========================================
# MODEL ARTIFACTS
# ==========================================
# IMPORTANT:
# Keep the trained fraud model required by the Render API.
# There is intentionally no blanket *.joblib ignore rule.
!api/models/fraud_detection_rf.joblib

# Other large model artifacts.
*.onnx
*.pt
*.pth
*.h5
*.keras

# ==========================================
# LOGS AND TEMPORARY FILES
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*.orig
*.bak

# ==========================================
# SUPABASE AND CLOUD TOOL STATE
# ==========================================
**/.supabase/.temp/

# ==========================================
# TYPESCRIPT AND NEXT.JS GENERATED FILES
# ==========================================
*.tsbuildinfo
next-env.d.ts

# ==========================================
# EDITORS AND OPERATING SYSTEMS
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

**/.vscode/
**/.idea/
*.iml

# ==========================================
# MULEWATCH ROOT
# ==========================================
# Duplicate of .env with credentials (no leading dot, so **/.env misses it).
/env

# Research model artefacts (scripts/train_candidate_no_step.py); metrics
# and thresholds stay committable, binaries do not.
research/**/*.joblib
