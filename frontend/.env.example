# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI inference service. Use http://127.0.0.1:8001 for a local uvicorn.
RENDER_API_URL=https://mulewatch.onrender.com

# Recommended: comma-separated emails allowed to read MuleWatch data.
# Unset = any user who can sign in to the Supabase project.
MULEWATCH_ANALYST_EMAILS=

# Optional: shared secret for server-to-server POST /api/predict (x-api-key).
MULEWATCH_API_KEY=

# Set to true to show self-service sign-up on the login page.
NEXT_PUBLIC_ENABLE_SIGNUP=false

# Optional: QStash delivery to POST /api/qstash/transactions (Upstash console →
# QStash → Signing keys). Server only. MULEWATCH_API_KEY must also be set.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public URL QStash calls, if it differs from the URL the server sees.
QSTASH_RECEIVER_URL=

# Optional: Kafka producer for POST /api/transactions/queue (Aiven, SASL_SSL).
# Server only. Comma-separated host:port list.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# plain (default), scram-sha-256 or scram-sha-512.
KAFKA_SASL_MECHANISM=plain
# Aiven project CA certificate (PEM). Newlines may be written as \n.
KAFKA_CA_CERT=
KAFKA_TOPIC=raw-transactions
